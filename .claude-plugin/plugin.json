{
  "name": "oh-my-uipath-c",
  "version": "0.3.0",
  "description": "Multi-agent orchestration for UiPath + Claude Code — autopilot, team, ralph, ask with uipathcli integration",
  "entry": "src/index.ts",
  "agents": "./agents/",
  "skills": "./skills/",
  "commands": "./commands/",
  "hooks": {
    "pre-tool-use": "src/hooks/pre-tool-use.ts",
    "post-tool-use": "src/hooks/post-tool-use.ts",
    "notification": "src/hooks/notification.ts"
  },
  "mcp": {
    "command": "omu-c",
    "args": ["mcp"]
  },
  "config": {
    "uipathcliPath": {
      "type": "string",
      "default": "uip",
      "description": "Path to uipathcli binary"
    },
    "skillsDir": {
      "type": "string",
      "default": "~/.agents/skills",
      "description": "Directory where uipath/skills are installed"
    },
    "orchestratorUrl": {
      "type": "string",
      "description": "Default UiPath Orchestrator URL"
    },
    "tenant": {
      "type": "string",
      "description": "Default tenant for deployments"
    },
    "autoScan": {
      "type": "boolean",
      "default": true,
      "description": "Auto-scan for UiPath projects on session start"
    },
    "lookoutLevel": {
      "type": "string",
      "enum": ["off", "advisory", "review-recommended", "block"],
      "default": "review-recommended",
      "description": "Minimum lookout severity to surface"
    }
  }
}
