{
  "name": "oh-my-UiPath-c",
  "version": "0.6.0",
  "description": "Multi-agent orchestration for UiPath + Claude Code, adapted from oh-my-claudecode",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "omu-c": "bin/oh-my-uipath.js"
  },
  "files": [
    "dist",
    "bin",
    "skills",
    "commands",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p packages/lookout/tsconfig.json && tsc",
    "dev": "tsc --watch",
    "lint": "eslint src/",
    "test": "node --experimental-strip-types src/__tests__/run-tests.ts",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": ["uipath", "claude-code", "orchestration", "autopilot", "multi-agent", "omc"],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/laurentc/RGA_Oh_My_UiPath.git"
  },
  "dependencies": {
    "commander": "^12.0.0",
    "yaml": "^2.4.0",
    "glob": "^10.3.0",
    "chalk": "^5.3.0"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "@types/node": "^22.0.0"
  }
}
